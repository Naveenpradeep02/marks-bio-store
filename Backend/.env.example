PORT=5000
CLIENT_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:5173

# Firebase is used ONLY to verify sign-in tokens (Firebase Authentication).
# All application data lives in MySQL.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
BOOTSTRAP_ADMIN_SECRET=change-this-to-a-long-random-string

# MySQL (raw mysql2 queries, no ORM). Run src/db/schema.sql once to create
# the database and tables before starting the server.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=marksbiotech
